{
  "name": "pixel-loom",
  "version": "2.0.0",
  "description": "Pixel Loom pixel animation editor: symmetry painting, seamless wrap canvas, flood fill, frames, undo/redo, local save and PNG export.",
  "private": true,
  "scripts": {
    "test": "node test/model.test.js && node test/e2e.test.js",
    "start": "node -e \"const http=require('http'),fs=require('fs'),path=require('path'),t={'.html':'text/html','.js':'text/javascript'};http.createServer((q,r)=>{const f=path.join(process.cwd(),q.url==='/'?'/index.html':q.url);fs.readFile(f,(e,d)=>e?(r.writeHead(404),r.end()):(r.writeHead(200,{'content-type':t[path.extname(f)]||'text/plain'}),r.end(d)))}).listen(8901,()=>console.log('http://127.0.0.1:8901'))\""
  }
}
